# HIGEN-ABSA Backend Configuration
# Copy this file to .env and modify as needed

# Model directory (absolute or relative to backend/)
ABSA_MODEL_DIR=models/visobert_absa_v8

# Device: auto, cuda, cpu
ABSA_DEVICE=auto

# Batch size for inference
ABSA_BATCH_SIZE=16

# Override model name (leave empty to use label_config.json)
# ABSA_MODEL_NAME=uitnlp/visobert

# Disable domain override rules
ABSA_NO_DOMAIN_OVERRIDES=false

# Server settings
ABSA_HOST=0.0.0.0
ABSA_PORT=8000
