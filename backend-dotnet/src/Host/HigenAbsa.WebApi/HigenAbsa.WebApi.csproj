<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\HigenAbsa.SharedKernel\HigenAbsa.SharedKernel.csproj" />
    <ProjectReference Include="..\..\Infrastructure\HigenAbsa.Infrastructure\HigenAbsa.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Security\HigenAbsa.Modules.Security\HigenAbsa.Modules.Security.csproj" />
    <ProjectReference Include="..\..\Modules\CoreSync\HigenAbsa.Modules.CoreSync\HigenAbsa.Modules.CoreSync.csproj" />
    <ProjectReference Include="..\..\Modules\Inference\HigenAbsa.Modules.Inference\HigenAbsa.Modules.Inference.csproj" />
    <ProjectReference Include="..\..\Modules\Engagement\HigenAbsa.Modules.Engagement\HigenAbsa.Modules.Engagement.csproj" />
    <ProjectReference Include="..\..\Modules\Reporting\HigenAbsa.Modules.Reporting\HigenAbsa.Modules.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>

